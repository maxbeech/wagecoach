import { createHmac } from "node:crypto";
import { verifyStripeSignature, SIGNATURE_TOLERANCE_SECONDS } from "../lib/stripe-signature.ts";
import { eq, report } from "./_assert.mts";

// Webhook signature checking, by hand, against Stripe's documented scheme
// (https://docs.stripe.com/webhooks, "Verify manually").

const SECRET = "whsec_test_secret_value";
const NOW = 1_800_000_000;
const sig = (body: string, t = NOW, secret = SECRET) => createHmac("sha256", secret).update(`${t}.${body}`).digest("hex");
const header = (body: string, t = NOW, secret = SECRET) => `t=${t},v1=${sig(body, t, secret)}`;
const check = (body: string, h: string | null | undefined, now = NOW, secret = SECRET) => verifyStripeSignature(body, h, secret, now);
const reasonOf = (r: ReturnType<typeof check>) => (r.ok ? "ok" : r.reason);

// Known answer, generated by the official `stripe` library
// (stripe.webhooks.generateTestHeaderString) and accepted by its constructEvent.
// This pins our hand-rolled check to Stripe's own implementation, not to our reading of the docs.
const VECTOR_BODY = '{"id":"evt_test_vector","object":"event","type":"checkout.session.completed"}';
const VECTOR_HEADER = "t=1700000000,v1=c5b2053e4dda2733bda508b39c7a8a3680208243eda30ad24ddc89464086e442";
eq(reasonOf(verifyStripeSignature(VECTOR_BODY, VECTOR_HEADER, "whsec_test_vector_secret", 1700000000)), "ok", "accepts a header made by the official Stripe library");
eq(reasonOf(verifyStripeSignature(VECTOR_BODY + " ", VECTOR_HEADER, "whsec_test_vector_secret", 1700000000)), "no_match", "official vector fails if the body gains one byte");

const body = '{"id":"evt_1","type":"checkout.session.completed","data":{"object":{"id":"cs_test_a1B2c3D4"}}}';
eq(reasonOf(check(body, header(body))), "ok", "a genuine signature passes");
eq(reasonOf(check(body, header(body, NOW, "whsec_other_secret"))), "no_match", "wrong secret fails");
eq(reasonOf(check(body.replace("evt_1", "evt_2"), header(body))), "no_match", "tampered body fails");
eq(reasonOf(check(body, `t=${NOW},v1=${sig(body, NOW - 1)}`)), "no_match", "a signature made for another timestamp fails, so the timestamp cannot be swapped");

// The raw body is what is signed: re-serialising parsed JSON changes the bytes and must fail.
const pretty = JSON.stringify(JSON.parse(body), null, 2);
eq(reasonOf(check(pretty, header(pretty))), "ok", "pretty-printed raw body passes when signed as sent");
eq(reasonOf(check(JSON.stringify(JSON.parse(pretty)), header(pretty))), "no_match", "re-serialised JSON fails against the original signature");
const unicode = '{"id":"evt_u","note":"café €10 ☃"}';
eq(reasonOf(check(unicode, header(unicode))), "ok", "non-ASCII body is signed over its UTF-8 bytes");

// Header shape.
eq(reasonOf(check(body, null)), "missing_header", "no header");
eq(reasonOf(check(body, undefined)), "missing_header", "undefined header");
eq(reasonOf(check(body, "")), "missing_header", "empty header");
eq(reasonOf(check(body, "garbage")), "malformed_header", "garbage header");
eq(reasonOf(check(body, `t=abc,v1=${sig(body)}`)), "malformed_header", "non-numeric timestamp");
eq(reasonOf(check(body, `t=${NOW}`)), "malformed_header", "no v1 signature");
eq(reasonOf(check(body, `v1=${sig(body)}`)), "malformed_header", "no timestamp");
eq(reasonOf(check(body, `t=${NOW},v0=${sig(body)}`)), "malformed_header", "a v0-only header is ignored (downgrade guard)");
eq(reasonOf(check(body, `t=${NOW},v1=${sig(body)},v0=${sig(body)}`)), "ok", "a v0 value alongside v1 is harmless");
eq(reasonOf(check(body, `t=${NOW},v0=${sig(body)},v1=deadbeef`)), "no_match", "valid v0 cannot stand in for a bad v1");
eq(reasonOf(check(body, `t=${NOW},v1=not-hex-at-all-${"z".repeat(50)}`)), "no_match", "non-hex v1 fails without throwing");
eq(reasonOf(check(body, `t=${NOW},v1=${sig(body).slice(0, 62)}`)), "no_match", "short v1 fails without throwing");
eq(reasonOf(check(body, `t=${NOW},v1=${sig(body)}00`)), "no_match", "long v1 fails without throwing");
eq(reasonOf(check(body, `  t=${NOW} , v1=${sig(body)}  `)), "ok", "spaces around parts are tolerated");
eq(reasonOf(check(body, `t=${NOW},v1=${sig(body).toUpperCase()}`)), "ok", "hex case does not matter");

// A rolled secret: Stripe sends one v1 per active secret; any match is enough.
eq(reasonOf(check(body, `t=${NOW},v1=${sig(body, NOW, "whsec_old_secret")},v1=${sig(body)}`)), "ok", "old and new secret both signed, new matches");
eq(reasonOf(check(body, `t=${NOW},v1=${sig(body)},v1=${sig(body, NOW, "whsec_old_secret")}`)), "ok", "new secret listed first");
eq(reasonOf(check(body, `t=${NOW},v1=${sig(body, NOW, "whsec_a")},v1=${sig(body, NOW, "whsec_b")}`)), "no_match", "neither matches");

// Replay window: five minutes either side.
eq(SIGNATURE_TOLERANCE_SECONDS, 300, "tolerance is five minutes");
eq(reasonOf(check(body, header(body, NOW - 299))), "ok", "299 seconds old passes");
eq(reasonOf(check(body, header(body, NOW - 300))), "ok", "exactly 300 seconds old passes");
eq(reasonOf(check(body, header(body, NOW - 301))), "stale_timestamp", "301 seconds old is refused");
eq(reasonOf(check(body, header(body, NOW + 301))), "stale_timestamp", "a timestamp 301 seconds in the future is refused");
eq(reasonOf(check(body, header(body, NOW - 3600))), "stale_timestamp", "an hour old is refused");
eq(reasonOf(check(body, header(body, NOW - 3600, "whsec_wrong"))), "no_match", "a forged old request reads as forged, not stale");

report("stripe-signature");
