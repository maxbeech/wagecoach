
# --- OpenHelm Mail (transactional email) ------------------------------------
# Both from this product's Mail tab. Without them sendEmail() returns
# { sent: false, reason: "not_configured" } and never pretends to have sent.
# There is no from-address to set: the platform stamps the one it has verified
# for this product.
OPENHELM_API_KEY=
OPENHELM_MAIL_INBOX_ID=

# ── OpenHelm Analytics (Google Analytics 4) ──────────────────────────────────
# This product's OWN GA4 property. Unset means no measurement at all: no tag is
# loaded and no events are sent — never a half-configured tag pointing at some
# other product's property. The id lives here rather than in code so that
# re-pointing the product at a different property is a config change.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Only for surfaces that have no browser (desktop shell, mobile app, server-side
# events). NOT public — it authorises writes into the property.
# GA_API_SECRET=
# Only for a native mobile app stream, which is keyed by Firebase app id rather
# than by measurement id.
# GA_FIREBASE_APP_ID=

# --- Sentry (errors, logs, user feedback) → project wagecoach_web -----------
# The DSN is public by design (it ships in the browser bundle). NEXT_PUBLIC_ is
# inlined at BUILD time, so set it in the host's build env as well as runtime.
NEXT_PUBLIC_SENTRY_DSN=https://b105e75ff744c7d45640a84bb38ffdfb@o4511897692405760.ingest.de.sentry.io/4511979397185616
SENTRY_DSN=https://b105e75ff744c7d45640a84bb38ffdfb@o4511897692405760.ingest.de.sentry.io/4511979397185616
SENTRY_ORG=maxed-labs
SENTRY_PROJECT=wagecoach_web
# Source-map upload only; secret, never commit.
# SENTRY_AUTH_TOKEN=
